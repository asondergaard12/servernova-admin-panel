# Server Configuration
PORT=3001
NODE_ENV=production

# Security Code - CHANGE THIS!
# This is the access code clients will use to access the admin panel
ADMIN_ACCESS_CODE=ChangeThisSecureCode123!

# Session Secret - CHANGE THIS!
SESSION_SECRET=ChangeThisRandomSecretKey456!

# Optional: Allowed IP addresses (comma-separated, leave empty to allow all)
# ALLOWED_IPS=192.168.1.100,192.168.1.101
